{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mlx-ruby.dev/schemas/mlxir_v1.schema.json",
  "title": "MLX Graph IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "shapeless",
    "inputs",
    "keyword_inputs",
    "outputs",
    "constants",
    "nodes"
  ],
  "properties": {
    "ir_version": {
      "const": 1
    },
    "shapeless": {
      "type": "boolean"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tensorInfo"
      }
    },
    "keyword_inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/keywordInput"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tensorInfo"
      }
    },
    "constants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constantInfo"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "$defs": {
    "tensorInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "shape",
        "dtype"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dtype": {
          "type": "string",
          "enum": [
            "bool",
            "bool_",
            "uint8",
            "uint16",
            "uint32",
            "uint64",
            "int8",
            "int16",
            "int32",
            "int64",
            "float16",
            "float32",
            "float64",
            "bfloat16",
            "complex64"
          ]
        }
      }
    },
    "constantInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "shape",
        "dtype",
        "values"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "dtype": {
          "type": "string",
          "enum": [
            "bool",
            "bool_",
            "uint8",
            "uint16",
            "uint32",
            "uint64",
            "int8",
            "int16",
            "int32",
            "int64",
            "float16",
            "float32",
            "float64",
            "bfloat16",
            "complex64"
          ]
        },
        "values": {
          "$ref": "#/$defs/valueTree"
        }
      }
    },
    "valueLeaf": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "__mlx_complex__"
          ],
          "properties": {
            "__mlx_complex__": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "valueTree": {
      "oneOf": [
        {
          "$ref": "#/$defs/valueLeaf"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valueTree"
          }
        }
      ]
    },
    "keywordInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tensor"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "tensor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "inputs",
        "outputs"
      ],
      "properties": {
        "op": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valueTree"
          }
        }
      }
    }
  }
}
